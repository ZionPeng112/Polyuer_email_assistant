MAIL_PROVIDER=gmail
# Optional local proxy for networks where Google APIs are not directly reachable.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Resend remains available as a fallback provider, but Gmail is the default path.
RESEND_API_KEY=re_xxxxx

# Gmail OAuth. Create this file from Google Cloud Console OAuth client credentials.
GMAIL_USER=me
GMAIL_ACCOUNT_EMAIL=zionpeng112@gmail.com
GOOGLE_OAUTH_CLIENT_SECRETS=credentials/google_oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=data/google_token.json

TARGET_EMAIL=zionpeng112@gmail.com
ALLOWED_SENDER_DOMAINS=polyu.edu.hk
LOCAL_TIMEZONE=Asia/Shanghai

N1N_API_KEY=xxxxx
N1N_BASE_URL=https://api.n1n.ai/v1
LLM_MODEL=YOUR_MODEL
N1N_TIMEOUT_SECONDS=180

DATABASE_URL=sqlite:///data/emails.db

DIGEST_RECIPIENT_EMAIL=pengqz112@gmail.com
DIGEST_FROM_EMAIL=zionpeng112@gmail.com
DIGEST_SUBJECT_PREFIX=PolyU 每日 email digest

# Optional image-to-LLM support. Requires a vision-capable LLM_MODEL behind n1n.
ENABLE_IMAGE_ANALYSIS=true
ENABLE_REMOTE_IMAGE_URLS=true
MAX_IMAGE_ATTACHMENTS=4
MAX_IMAGE_BYTES=2000000
